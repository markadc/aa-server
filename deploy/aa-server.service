[Unit]
Description=pcc 授权服务端 (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/aa-server
Environment=PCC_CONFIG=/opt/aa-server/config.toml
# 用 venv 里的 python -m uvicorn；直接跑 uvicorn 会解析到系统全局包
ExecStart=/opt/aa-server/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8800
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
